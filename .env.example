# Kopiera till en env-fil utanför repot (t.ex. /etc/tempwatch/tempwatch.env, root:docker 640)
TZ=Europe/Stockholm
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=
ADAX_CLIENT_ID=
ADAX_CLIENT_SECRET=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Elpris i kr/kWh inkl. nät och skatt, t.ex. 1,80. Lämna tomt för att bara visa kWh.
ELECTRICITY_PRICE_SEK_PER_KWH=
# Alternativ: medelspotpris från elprisetjustnu.se (ersätter fast pris ovan)
ELECTRICITY_AREA=
# Nät, skatt och påslag i kr/kWh exkl. moms (rörlig del), t.ex. 0,60
ELECTRICITY_ADDON_SEK_PER_KWH=
# Moms som decimal; standard 0,25
ELECTRICITY_VAT=

# Kopiera till en env-fil utanför repot, t.ex. /etc/tempwatch/tempwatch.env (root:docker, 640).
# Värden skrivs utan citattecken.
TZ=Europe/Stockholm

# Ecowitt (api.ecowitt.net): nycklar skapas under Account -> API Management
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=

# Adax Wi-Fi API: Client ID är ditt Account ID (siffror), secret är lösenordet
ADAX_CLIENT_ID=
ADAX_CLIENT_SECRET=

# Telegram (egen bot via @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Elkostnad. Antingen medelspot för ett elområde + påslag ...
ELECTRICITY_AREA=
# ... nät, skatt, elhandlarens påslag och rörliga avgifter, kr/kWh exkl. moms
ELECTRICITY_ADDON_SEK_PER_KWH=
# Moms som decimal; standard 0,25
ELECTRICITY_VAT=
# ... eller ett fast pris inkl. allt, kr/kWh (används om ELECTRICITY_AREA är tomt)
ELECTRICITY_PRICE_SEK_PER_KWH=

# Elementkontrollen (valfritt, standardvärden i parentes)
# ANOMALY_FACTOR=1,5            gånger över normalt
# ANOMALY_MIN_EXTRA_WH=1000     minsta ökning i Wh per dygn
# ANOMALY_MIN_BASELINE_WH=500   element med lägre normalvärde jämförs inte

# Sökväg för tillstånd och provlogg (standard /state/snapshots.json)
# TEMPWATCH_STATE=/state/snapshots.json

# Frostlarm för Ecowitts inomhussensor (standardvärden i parentes)
# ALERT_INDOOR_BELOW_C=8     larma under denna temperatur
# ALERT_HYSTERESIS_C=1       larmet släcks först vid gräns + detta
# ALERT_REPEAT_HOURS=6       påminnelse så ofta medan det är kallt

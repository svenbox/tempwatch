# Kopiera till en env-fil utanför repot, t.ex. /etc/tempwatch/tempwatch.env (root:docker, 640).
# Värden skrivs utan citattecken.
TZ=Europe/Stockholm

# Ecowitt (api.ecowitt.net): nycklar skapas under Account -> API Management
ECOWITT_APPLICATION_KEY=
ECOWITT_API_KEY=
ECOWITT_MAC=

# Adax Wi-Fi API: Client ID är ditt Account ID (siffror), secret är lösenordet
ADAX_CLIENT_ID=
ADAX_CLIENT_SECRET=

# Telegram (egen bot via @BotFather)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Elkostnad. Antingen medelspot för ett elområde + påslag ...
ELECTRICITY_AREA=
# Medelspot över "month" (månaden hittills, som ett rörligt avtal faktureras; standard)
# eller "period" (samma period som energin)
# ELECTRICITY_SPOT_BASIS=month
# ... allt rörligt utöver spot, kr/kWh exkl. moms: elhandlarens påslag + rörliga kostnader
# - rabatt + energiskatt + nätets överföringsavgift (se docs/drift.md, avsnitt Elkostnad)
ELECTRICITY_ADDON_SEK_PER_KWH=
# Moms som decimal; standard 0,25
ELECTRICITY_VAT=
# ... eller ett fast pris inkl. allt, kr/kWh (används om ELECTRICITY_AREA är tomt)
ELECTRICITY_PRICE_SEK_PER_KWH=
# Fasta avgifter per månad, kr INKL. moms (nätets fasta avgift + elhandlarens månadsavgift).
# Visas per dygn och i månadssumman, men ingår inte i energins kostnad.
# ELECTRICITY_FIXED_SEK_PER_MONTH=

# Elementkontrollen (valfritt, standardvärden i parentes)
# ANOMALY_FACTOR=1,5            gånger över normalt
# ANOMALY_MIN_EXTRA_WH=1000     minsta ökning i Wh per dygn
# ANOMALY_MIN_BASELINE_WH=500   element med lägre normalvärde jämförs inte

# Sökväg för tillstånd och provlogg (standard /state/snapshots.json)
# TEMPWATCH_STATE=/state/snapshots.json

# Frostlarm för Ecowitts inomhussensor (standardvärden i parentes)
# ALERT_INDOOR_BELOW_C=8     larma under denna temperatur
# ALERT_HYSTERESIS_C=1       larmet släcks först vid gräns + detta
# ALERT_REPEAT_HOURS=6       påminnelse så ofta medan det är kallt
# ALERT_STALE_MINUTES=90     vakthund: larma om sensorn inte rapporterat på så här länge
# ALERT_FAIL_CHECKS=3        vakthund: antal misslyckade kontroller i rad före larm
# ALERT_WATCH_REPEAT_HOURS=12  vakthund: påminnelse så ofta medan felet kvarstår

# Extern övervakning (healthchecks.io), se docs/drift.md. Två kontroller:
# frostkontrollen var 15:e minut (lyckat eller /fail med orsak) ...
# HEARTBEAT_URL=https://hc-ping.com/<uuid>
# ... och morgonnotisen kl 07:30.
# HEARTBEAT_NOTICE_URL=https://hc-ping.com/<uuid>
